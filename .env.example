# Crow provider configuration
# Open the TUI and use /connect to choose a provider and save its API key.
# Or set a provider API key directly, for example:
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...
# DASHSCOPE_API_KEY=sk-...
# MOONSHOT_API_KEY=sk-...
# ZHIPU_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# TOGETHER_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...
# MISTRAL_API_KEY=...
# GEMINI_API_KEY=...
# MINIMAX_API_KEY=...
# STEPFUN_API_KEY=
# VENICE_API_KEY=
# DIGITALOCEAN_ACCESS_TOKEN=
# BASETEN_API_KEY=
# NVIDIA_API_KEY=
# OPENCODE_API_KEY=
# COHERE_API_KEY=
# PERPLEXITY_API_KEY=
# SAMBANOVA_API_KEY=
# NEBIUS_API_KEY=
# DEEPINFRA_API_KEY=
# FIREWORKS_API_KEY=
# CEREBRAS_API_KEY=...

# Optional: Provider to use by default (for example openai, deepseek, qwen)
# CROW_PROVIDER=openai

# Optional: Default model (default: first model of the selected provider)
# CROW_MODEL=gpt-5

# Optional: Max tokens per response (default: 16384)
# CROW_MAX_TOKENS=16384

# Optional: Telegram bot token for /remote-control -> Telegram
# TELEGRAM_BOT_TOKEN=<redacted>
